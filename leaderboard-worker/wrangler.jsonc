{
  // The global leaderboard API: a Worker with a D1 database. Deployed on its own (see README.md), separate
  // from the game's static site so a site deploy never depends on the database.
  "name": "hsfhc-leaderboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Posts come through the game's own domain, where the sign-in cookie is sent (a route there takes priority over
  // the static site); the board can still be read at the worker's own address
  "routes": [{ "pattern": "footballcoachgame.com/api/hof/*", "zone_name": "footballcoachgame.com" }],
  // Keep the worker's own address too (wrangler turns it off when routes are set): older game versions read it
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hsfhc-leaderboard",
      // Paste the id printed by `npx wrangler d1 create hsfhc-leaderboard`
      "database_id": "207adbc5-935d-452f-8823-dd4d2f3e33de",
      "migrations_dir": "migrations"
    },
    {
      // The sign-in server's database (auth-worker/): only its sessions are read, to know who is posting
      "binding": "AUTH_DB",
      "database_name": "hsfhc-auth",
      "database_id": "51c9ea67-49af-4389-8fcc-6ec8528ada03"
    }
  ],
  "vars": {
    // The game's site (comma-separated if more than one); add http://localhost:3000 to test from the dev server
    "ALLOWED_ORIGINS": "https://footballcoachgame.com,https://www.footballcoachgame.com,https://high-school-football-coach.protheus99.workers.dev,http://localhost:3000"
  }
}
