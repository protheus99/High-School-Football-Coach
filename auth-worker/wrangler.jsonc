{
	// Player accounts: a Worker with a D1 database, on the game's own domain at /api/auth/* (a route there takes
	// priority over the game's static site). Deployed on its own (see README.md); run every command from this folder.
	"name": "hsfhc-auth",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"routes": [
		{
			"pattern": "footballcoachgame.com/api/auth/*",
			"zone_name": "footballcoachgame.com"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hsfhc-auth",
			"database_id": "51c9ea67-49af-4389-8fcc-6ec8528ada03",
			"migrations_dir": "migrations"
		}
	],
	// Cloud saves: the save files (create the bucket once with `npx wrangler r2 bucket create hsfhc-saves`)
	"r2_buckets": [
		{
			"binding": "SAVES",
			"bucket_name": "hsfhc-saves"
		}
	],
	"vars": {
		"APP_URL": "https://footballcoachgame.com",
		// The game's pages that may call the API (POSTs from anywhere else are refused)
		"ALLOWED_ORIGINS": "https://footballcoachgame.com,https://www.footballcoachgame.com,http://localhost:3000",
		// Public ids (not secrets). An empty one turns that sign-in option off.
		"GOOGLE_CLIENT_ID": "258872076396-bd8oirb491rkdpa1hvdhv9i7m0i2vudt.apps.googleusercontent.com",
		"FACEBOOK_APP_ID": "",
		"FACEBOOK_GRAPH_VERSION": "v23.0",
		"EMAIL_FROM": "Football Coach <signin@footballcoachgame.com>"
	}
	// Secrets, set with `npx wrangler secret put NAME` (never in this file):
	//   GOOGLE_CLIENT_SECRET, FACEBOOK_APP_SECRET, RESEND_API_KEY
}